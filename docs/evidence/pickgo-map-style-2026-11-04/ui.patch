+.map-shell{height:100dvh;max-width:1920px;margin:auto;padding:0 40px;display:grid;grid-template-rows:76px minmax(0,1fr) 52px}
+.map-page header{justify-content:flex-start}
+.map-page a{color:inherit}
+.brand{font-size:26px;font-weight:650;text-decoration:none}
+.map-context{font-size:20px;color:var(--muted)}
+.map-page .back-link{margin-left:auto;min-height:52px;font-size:20px;padding:10px 20px}
+.map-page main{display:grid;grid-template-columns:400px minmax(0,1fr);gap:24px;padding:12px 0 8px;min-height:0}
+.map-page aside{min-width:0;overflow:hidden;background:var(--surface);display:flex;flex-direction:column}
+.map-page h1{font-size:30px;line-height:1.3;margin-bottom:12px;letter-spacing:-.5px}
+.map-page h2{font-size:22px;line-height:1.4;letter-spacing:0;margin:24px 0 8px}
+.map-page p{font-size:18px;line-height:1.5}
+.intro{margin-bottom:20px}.intro br{display:none}
+.legend{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:16px}
+.swatch{display:inline-block;width:14px;height:14px;border-radius:50%}
+.swatch.blocked{background:#ba5147}.swatch.possible{background:#345e42;margin-left:12px;border:1px solid #91b09c}
+.map-page .help{margin:12px 0 16px}
+.controls{display:flex;flex-wrap:wrap;gap:12px;align-items:center;font-size:16px}
+.map-page .controls button{min-height:64px;font-size:18px;padding:12px 16px}
+.controls label{display:flex;gap:8px;align-items:center;min-height:48px;cursor:pointer}
+.controls input{width:22px;height:22px;margin:0;accent-color:#e7e7e7}
+.map-page .caption{font-size:16px;margin-bottom:12px}
+#candidates{display:grid;gap:12px}
+.map-page .candidate{width:100%;display:grid;grid-template-columns:32px minmax(0,1fr);gap:12px;text-align:left;justify-content:stretch;min-height:88px;padding:14px 16px;margin:0}
+.number{width:32px;height:32px;display:grid;place-items:center;background:#345e42;color:#fff;border:1px solid #91b09c;border-radius:50%;font-size:18px;font-weight:650}
+.candidate strong{font-size:20px;font-weight:600}.candidate small{display:block;font-size:16px;color:var(--muted);font-weight:400;margin-top:4px}
+.selection{border-top:1px solid #464646;margin-top:24px;padding-top:20px}
+.selection h2{margin-top:0}.selection p{margin-top:8px}
+.map-page #confirm{width:100%;background:#e7e7e7;color:#161616;margin-top:16px;font-size:22px;min-height:76px}
+.map-page #confirm:disabled{background:#303030;color:#a5a5a5}
+.map-page #confirm:hover:not(:disabled){background:#fff}
+.selection.bad #selectionTitle{color:#f0a39d}
+#coordinates{font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
+.map-page #coordinates,.map-page #roomState{font-size:16px}
+.map-page details{font-size:16px;line-height:1.6;border-top:1px solid #464646;margin-top:24px;padding-top:16px}
+.map-page details p{font-size:16px;margin:12px 0}
+.map-page summary{cursor:pointer;min-height:48px;padding:10px 0}
+.map-page details a{text-underline-offset:3px}
+.maparea{min-width:0;min-height:0;background:var(--surface);display:grid;grid-template-rows:auto minmax(0,1fr) auto auto;overflow:hidden}
+.map-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:16px 20px}
+.map-heading h2{margin:0}.map-heading span{font-size:16px;color:var(--muted)}
+#map{width:100%;height:100%;min-height:0;background:#dce0db;isolation:isolate}
+.leaflet-container{font-family:Asta,'Malgun Gothic',sans-serif;color:#242822}
