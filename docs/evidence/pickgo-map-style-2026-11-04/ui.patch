+ .map-shell{height:auto;min-height:100dvh;padding:0 24px;grid-template-rows:auto 1fr auto}
+ .map-page header{min-height:72px;gap:12px;flex-wrap:wrap;padding:8px 0}.brand{font-size:24px}.map-context{font-size:18px}
+ .map-page main{display:flex;flex-direction:column;gap:16px;padding:8px 0 16px}
+ .maparea{order:0;flex:none;grid-template-rows:auto minmax(0,1fr) auto auto;height:54dvh;min-height:360px}
+ .map-page aside{order:1;overflow:visible;padding:24px}
+ .map-page footer{min-height:48px;padding:12px 0;font-size:16px}
+ .map-page h1{font-size:28px}
+}
+@media(max-width:479px){
+ .map-shell{padding:0 16px}.map-context{display:none}.brand{font-size:22px}.map-page .back-link{font-size:18px}
+ .map-page aside{padding:20px 16px}.map-heading{padding:12px 16px}.map-heading h2{font-size:20px}.map-heading span{font-size:14px}
+ .map-page #mapNotice,.map-page #error{padding:12px 16px}.map-page h1{font-size:26px}
+ .map-page .candidate{padding:14px 12px}.map-page .leaflet-control-attribution{font-size:11px!important}
+}
+
+/* Keep the selected point and its action visible while browsing nearby candidates. */
+.map-options{min-height:0;overflow:auto;overscroll-behavior:contain;padding:24px;scrollbar-width:thin;scrollbar-color:#737373 var(--surface)}
+.map-page .selection{flex:none;margin:0;padding:20px 24px;background:var(--surface);max-height:55%;overflow:auto;scrollbar-width:thin}
+.map-page .selection h2{font-size:22px}
+@media(max-width:899px){.map-page aside{padding:0;overflow:visible}.map-options{overflow:visible;padding:24px}.map-page .selection{max-height:none;overflow:visible;padding:24px}}
+@media(max-width:479px){.map-options,.map-page .selection{padding:20px 16px}}
